<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>indra-vlm</AssemblyName>
    <RootNamespace>IndraOcr.Vlm.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>indra-vlm</ToolCommandName>
    <PackageId>IndraOCR.Vlm.Cli</PackageId>
    <!-- A page takes seconds to minutes; compile optimised up front rather than tiering. -->
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndraOcr.Vlm\IndraOcr.Vlm.csproj" />
  </ItemGroup>

</Project>
