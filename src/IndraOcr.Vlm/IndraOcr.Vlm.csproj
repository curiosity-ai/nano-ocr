<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>IndraOcr.Vlm</RootNamespace>
    <AssemblyName>IndraOcr.Vlm</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>IndraOCR.Vlm</PackageId>
    <Title>Chandra 2 and Surya 2 vision-language OCR for .NET</Title>
    <Description>Pure C# implementation of the Qwen3.5 vision-language model behind Datalab's Chandra 2 and Surya 2 OCR, with their pipelines. No ONNX Runtime, no libtorch.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IndraOcr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndraOcr\IndraOcr.csproj" />
  </ItemGroup>

</Project>
