<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nano-ocr</AssemblyName>
    <RootNamespace>NanoOcr.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nano-ocr</ToolCommandName>
    <PackageId>NanoOCR.Cli</PackageId>
    <!-- The tool is a short-lived process. Methods with loops (every kernel) are compiled
         optimised on first call; the loop-free rest starts quick and tiers up. Cold page ~10%
         faster than compiling everything optimised up front, warm throughput the same. -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanoOcr\NanoOcr.csproj" />
  </ItemGroup>

</Project>
