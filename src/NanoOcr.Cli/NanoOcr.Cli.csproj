<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nano-ocr</AssemblyName>
    <RootNamespace>NanoOcr.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nano-ocr</ToolCommandName>
    <PackageId>NanoOCR.Cli</PackageId>
    <!-- The tool is a short-lived process: compile optimised up front instead of tiering. -->
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanoOcr\NanoOcr.csproj" />
  </ItemGroup>

</Project>
