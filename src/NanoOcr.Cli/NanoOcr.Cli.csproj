<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>nano-ocr</AssemblyName>
    <RootNamespace>NanoOcr.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nano-ocr</ToolCommandName>
    <PackageId>NanoOCR.Cli</PackageId>
    <!-- .NET 10 RID-specific tool: `dotnet pack` writes one NanoOCR.Cli.<rid> package per runtime,
         each with only that platform's PDFium and SkiaSharp, and a small NanoOCR.Cli pointer package
         from which `dotnet tool install` picks the right one. Framework-dependent, so the JIT (not
         ReadyToRun or AOT, see CLAUDE.md) compiles the kernels for the machine they run on. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <!-- The tool is a short-lived process: compile optimised up front instead of tiering. -->
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanoOcr\NanoOcr.csproj" />
  </ItemGroup>

</Project>
