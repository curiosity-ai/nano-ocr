<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NanoOcr</RootNamespace>
    <AssemblyName>NanoOcr</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>NanoOCR</PackageId>
    <Title>NanoOCR</Title>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NanoOcr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The models ship inside the assembly: no download, no model folder to manage. -->
    <EmbeddedResource Include="Models/Assets/*.onnx;Models/Assets/*.json" LogicalName="NanoOcr.Models.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="157.0.8100" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8100" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="157.0.8100" />
  </ItemGroup>

</Project>
